import asyncio
import os
from dotenv import load_dotenv

from livekit.agents import (
    Agent,
    AgentSession,
    AgentServer,
    JobContext,
    cli,
    AutoSubscribe,  # Audio-only subscription
)
from livekit.plugins import google, silero

load_dotenv(dotenv_path="agentic.env")

class LowLatencyAssistant(Agent):
    def __init__(self):
        # Short system prompt = faster inference
        super().__init__(
            instructions=(
                "You are a fast, concise voice assistant. "
                "Respond in 1-2 short sentences. No filler words."
            ),
        )

server = AgentServer()

@server.rtc_session()
async def entrypoint(ctx: JobContext):
    # 1. Connect audio-only: skips video codec negotiation (~200ms saved)
    await ctx.connect(auto_subscribe=AutoSubscribe.AUDIO_ONLY)
    
    # 2. Aggressive VAD: detects end-of-speech faster
    #    (cuts 300-500ms of silence padding before Gemini starts thinking)
    vad = silero.VAD.load(
        min_speech_duration=0.05,      # default ~0.15s
        min_silence_duration=0.25,     # default ~0.5s — lower = faster response
        activation_threshold=0.2,      # default ~0.5 — more sensitive to catch voice sooner
    )
    
    # 3. Gemini Flash: native audio-to-audio (lowest latency model)
    llm = google.realtime.RealtimeModel(
        model="gemini-2.5-flash-native-audio-preview-12-2025",
        voice="Puck",  # Puck is the fastest/neutral voice
        api_key=os.getenv("GOOGLE_API_KEY"),
        # Lower temperature can reduce token generation variance (slight speedup)
        temperature=0.7,
    )
    
    # 4. Session with minimal buffering
    session = AgentSession(
        llm=llm,
        vad=vad,
        # If available in your livekit-agents version:
        # min_playout_delay=0.0,
        # max_playout_delay=0.05,
    )
    
    await session.start(
        room=ctx.room,
        agent=LowLatencyAssistant(),
    )

if __name__ == "__main__":
    cli.run_app(server)


